# Use a real hostname after its DNS A record points to the Contabo VPS.
# For temporary HTTP-by-IP testing, use DOMAIN=http://203.0.113.10 and
# SITE_ORIGIN=http://203.0.113.10.
DOMAIN=deals.example.com
SITE_ORIGIN=https://deals.example.com

POSTGRES_DB=affiliate
POSTGRES_USER=affiliate
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://affiliate:replace-with-the-same-url-encoded-password@db:5432/affiliate

JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_NAME=Administrator
