generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SectionType {
  HERO
  STORE_LOGOS
  FEATURED_PRODUCTS
  CATEGORY_GRID
  STORE_PRODUCTS
  PROMO_BANNER
  BLOG
  TRUST_FEATURES
  CUSTOM
}

enum AdminRole {
  OWNER
  ADMIN
  EDITOR
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  description      String?
  shortDescription String?
  currentPrice     Decimal?        @db.Decimal(12, 2)
  oldPrice         Decimal?        @db.Decimal(12, 2)
  discountPercent  Int?
  rating           Decimal?        @db.Decimal(2, 1)
  reviewCount      Int             @default(0)
  affiliateUrl     String
  ctaLabel         String          @default("View deal")
  badge            String?
  sku              String?
  availability     String?
  tags             String[]
  status           Status          @default(DRAFT)
  featured         Boolean         @default(false)
  seoTitle         String?
  seoDescription   String?
  categoryId       String?
  category         Category?       @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand             Brand?          @relation(fields: [brandId], references: [id])
  storeId          String?
  store             Store?          @relation(fields: [storeId], references: [id])
  images            ProductImage[]
  deals             Deal[]
  affiliateLinks    AffiliateLink[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  altText   String?
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  icon           String?
  image          String?
  description    String?
  status         Status     @default(ACTIVE)
  sortOrder      Int        @default(0)
  seoTitle       String?
  seoDescription String?
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryTree")
  products       Product[]
}

model Brand {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  logo           String?
  description    String?
  active         Boolean   @default(true)
  seoTitle       String?
  seoDescription String?
  products       Product[]
}

model Store {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  logo             String?
  description      String?
  websiteUrl       String?
  affiliateBaseUrl String?
  color            String?
  active           Boolean   @default(true)
  seoTitle         String?
  seoDescription   String?
  products         Product[]
  banners          Banner[]
}

model Deal {
  id              String       @id @default(cuid())
  slug            String       @unique
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountPercent Int?
  startsAt        DateTime
  endsAt          DateTime
  status          Status       @default(DRAFT)
  featured        Boolean      @default(false)
  badge           String?
  seo             SeoMetadata?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  image       String?
  logo        String?
  background  String?
  buttonLabel String?
  buttonUrl   String?
  startsAt    DateTime?
  endsAt      DateTime?
  status      Status   @default(DRAFT)
  sortOrder   Int      @default(0)
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id])
}

model HomepageSection {
  id         String      @id @default(cuid())
  type       SectionType
  title      String?
  subtitle   String?
  sortOrder  Int         @default(0)
  visible    Boolean     @default(true)
  maxItems   Int?
  background String?
  ctaText    String?
  ctaUrl     String?
  config     Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model BlogCategory {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String?
  content        String
  coverImage     String?
  author         String?
  tags           String[]
  status         Status        @default(DRAFT)
  publishedAt    DateTime?
  readingTime    Int?
  seoTitle       String?
  seoDescription String?
  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model NavigationItem {
  id        String           @id @default(cuid())
  label     String
  url       String
  sortOrder Int              @default(0)
  active    Boolean          @default(true)
  parentId  String?
  parent    NavigationItem?  @relation("NavigationTree", fields: [parentId], references: [id])
  children  NavigationItem[] @relation("NavigationTree")
}

model FooterSection {
  id        String  @id @default(cuid())
  title     String
  content   String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  links     Json?
}

model AffiliateLink {
  id         String   @id @default(cuid())
  label      String
  url        String
  clickCount Int      @default(0)
  active     Boolean  @default(true)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
}

model SeoMetadata {
  id             String  @id @default(cuid())
  entityType     String
  entityId       String?
  title          String?
  description    String?
  canonicalUrl   String?
  openGraphImage String?
  noIndex        Boolean @default(false)
  jsonLd         Json?
  dealId         String? @unique
  deal           Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
}

model SiteSettings {
  id                    String   @id @default("global")
  websiteName           String
  logo                  String?
  favicon               String?
  primaryColor          String   @default("#101a2f")
  accentColor           String   @default("#f36b2b")
  supportEmail          String?
  socialMedia           Json?
  defaultSeoTitle       String?
  defaultSeoDescription String?
  affiliateDisclosure   String?
  copyright             String?
  analyticsIds          Json?
  updatedAt             DateTime @updatedAt
}
