generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SectionType {
  HERO
  STORE_LOGOS
  FEATURED_PRODUCTS
  CATEGORY_GRID
  STORE_PRODUCTS
  PROMO_BANNER
  BLOG
  TRUST_FEATURES
  CUSTOM
}

enum AdminRole {
  OWNER
  ADMIN
  EDITOR
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id                    String                    @id @default(cuid())
  title                 String
  slug                  String                    @unique
  description           String?
  shortDescription      String?
  currentPrice          Decimal?                  @db.Decimal(12, 2)
  oldPrice              Decimal?                  @db.Decimal(12, 2)
  discountPercent       Int?
  rating                Decimal?                  @db.Decimal(2, 1)
  reviewCount           Int                       @default(0)
  affiliateUrl          String?
  ctaLabel              String                    @default("View deal")
  badge                 String?
  sku                   String?
  availability          String?
  keyFeatures           String[]                  @default([])
  pros                  String[]                  @default([])
  cons                  String[]                  @default([])
  whyRecommend          String?
  bestFor               String?
  buyingAdvice          String?
  editorialSummary      String?
  idealFor              String?
  notIdealFor           String?
  importantSpecs        Json?
  comparisonNotes       String?
  dealAnalysis          String?
  alternativesNotes     String?
  whatWeLike            String?
  whatCouldBeBetter     String?
  bestUseCases          String[]                  @default([])
  faqItems              Json?
  lastVerifiedAt        DateTime?
  priceUpdatedAt        DateTime?
  contentUpdatedAt      DateTime?
  tags                  String[]
  status                Status                    @default(DRAFT)
  featured              Boolean                   @default(false)
  seoTitle              String?
  seoDescription        String?
  canonicalUrl          String?
  ogTitle               String?
  ogDescription         String?
  ogImage               String?
  robotsIndex           Boolean                   @default(true)
  robotsFollow          Boolean                   @default(true)
  schemaEnabled         Boolean                   @default(true)
  categoryId            String?
  category              Category?                 @relation(fields: [categoryId], references: [id])
  brandId               String?
  brand                 Brand?                    @relation(fields: [brandId], references: [id])
  storeId               String?
  store                 Store?                    @relation(fields: [storeId], references: [id])
  images                ProductImage[]
  deals                 Deal[]
  affiliateLinks        AffiliateLink[]
  homepagePlacements    HomepageSectionProduct[]
  categoryFeatures      CategoryFeaturedProduct[]
  buyingGuidePlacements BuyingGuideProduct[]
  comparisonPlacements  ComparisonProduct[]
  blogPlacements        BlogPostProduct[]
  affiliateClicks       AffiliateClick[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  altText   String?
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id                 String                    @id @default(cuid())
  name               String
  slug               String                    @unique
  icon               String?
  image              String?
  description        String?
  h1                 String?
  editorialContent   String?
  buyingTips         String[]                  @default([])
  faqItems           Json?
  status             Status                    @default(ACTIVE)
  sortOrder          Int                       @default(0)
  seoTitle           String?
  seoDescription     String?
  canonicalUrl       String?
  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  robotsIndex        Boolean                   @default(true)
  robotsFollow       Boolean                   @default(true)
  schemaEnabled      Boolean                   @default(true)
  parentId           String?
  parent             Category?                 @relation("CategoryTree", fields: [parentId], references: [id])
  children           Category[]                @relation("CategoryTree")
  products           Product[]
  featuredProducts   CategoryFeaturedProduct[]
  guides             BuyingGuide[]
  blogPlacements     BlogPostCategory[]
  homepagePlacements HomepageSectionCategory[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @default(now()) @updatedAt
}

model CategoryFeaturedProduct {
  categoryId String
  productId  String
  sortOrder  Int      @default(0)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([categoryId, productId])
}

model Brand {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  logo           String?
  description    String?
  active         Boolean   @default(true)
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  robotsIndex    Boolean   @default(true)
  robotsFollow   Boolean   @default(true)
  schemaEnabled  Boolean   @default(true)
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
}

model Store {
  id                   String                 @id @default(cuid())
  name                 String
  slug                 String                 @unique
  logo                 String?
  description          String?
  editorialNotes       String?
  shoppingTips         String[]               @default([])
  faqItems             Json?
  websiteUrl           String?
  affiliateBaseUrl     String?
  color                String?
  active               Boolean                @default(true)
  seoTitle             String?
  seoDescription       String?
  canonicalUrl         String?
  ogTitle              String?
  ogDescription        String?
  ogImage              String?
  robotsIndex          Boolean                @default(true)
  robotsFollow         Boolean                @default(true)
  schemaEnabled        Boolean                @default(true)
  products             Product[]
  banners              Banner[]
  homepagePlacements   HomepageSectionStore[]
  comparisonPlacements ComparisonStore[]
  affiliateClicks      AffiliateClick[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt
}

model Deal {
  id              String       @id @default(cuid())
  slug            String       @unique
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountPercent Int?
  startsAt        DateTime
  endsAt          DateTime
  status          Status       @default(DRAFT)
  featured        Boolean      @default(false)
  badge           String?
  seoTitle        String?
  seoDescription  String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  robotsIndex     Boolean      @default(false)
  robotsFollow    Boolean      @default(true)
  schemaEnabled   Boolean      @default(false)
  seo             SeoMetadata?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Banner {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  image       String?
  logo        String?
  background  String?
  buttonLabel String?
  buttonUrl   String?
  startsAt    DateTime?
  endsAt      DateTime?
  status      Status    @default(DRAFT)
  sortOrder   Int       @default(0)
  storeId     String?
  store       Store?    @relation(fields: [storeId], references: [id])
}

model HomepageSection {
  id         String                    @id @default(cuid())
  type       SectionType
  title      String?
  subtitle   String?
  sortOrder  Int                       @default(0)
  visible    Boolean                   @default(true)
  maxItems   Int?
  background String?
  ctaText    String?
  ctaUrl     String?
  config     Json?
  products   HomepageSectionProduct[]
  categories HomepageSectionCategory[]
  stores     HomepageSectionStore[]
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
}

model HomepageSectionProduct {
  sectionId String
  productId String
  sortOrder Int             @default(0)
  section   HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([sectionId, productId])
}

model HomepageSectionCategory {
  sectionId  String
  categoryId String
  sortOrder  Int             @default(0)
  section    HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  category   Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([sectionId, categoryId])
}

model HomepageSectionStore {
  sectionId String
  storeId   String
  sortOrder Int             @default(0)
  section   HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([sectionId, storeId])
}

model BlogCategory {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model BlogPost {
  id                         String             @id @default(cuid())
  title                      String
  slug                       String             @unique
  excerpt                    String?
  content                    String
  coverImage                 String?
  productLinks               String[]           @default([])
  author                     String?
  authorId                   String?
  authorProfile              Author?            @relation(fields: [authorId], references: [id])
  tags                       String[]
  status                     Status             @default(DRAFT)
  publishedAt                DateTime?
  readingTime                Int?
  seoTitle                   String?
  seoDescription             String?
  canonicalUrl               String?
  ogTitle                    String?
  ogDescription              String?
  ogImage                    String?
  robotsIndex                Boolean            @default(true)
  robotsFollow               Boolean            @default(true)
  schemaEnabled              Boolean            @default(true)
  faqItems                   Json?
  contentUpdatedAt           DateTime?
  categoryId                 String?
  category                   BlogCategory?      @relation(fields: [categoryId], references: [id])
  productPlacements          BlogPostProduct[]
  guidePlacements            BlogPostGuide[]
  commerceCategoryPlacements BlogPostCategory[]
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
}

model Author {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  bio          String?
  profileImage String?
  expertise    String[]      @default([])
  profileUrls  String[]      @default([])
  active       Boolean       @default(true)
  posts        BlogPost[]
  guides       BuyingGuide[]
  comparisons  Comparison[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model BuyingGuide {
  id                String               @id @default(cuid())
  title             String
  slug              String               @unique
  intro             String
  body              String?
  editorialSections Json?
  heroImage         String?
  heroImageAlt      String?
  faqItems          Json?
  status            Status               @default(DRAFT)
  publishedAt       DateTime?
  categoryId        String?
  category          Category?            @relation(fields: [categoryId], references: [id])
  authorId          String?
  author            Author?              @relation(fields: [authorId], references: [id])
  products          BuyingGuideProduct[]
  blogPlacements    BlogPostGuide[]
  seoTitle          String?
  seoDescription    String?
  canonicalUrl      String?
  ogTitle           String?
  ogDescription     String?
  ogImage           String?
  robotsIndex       Boolean              @default(true)
  robotsFollow      Boolean              @default(true)
  schemaEnabled     Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model BuyingGuideProduct {
  guideId   String
  productId String
  sortOrder Int         @default(0)
  note      String?
  guide     BuyingGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([guideId, productId])
}

model BlogPostProduct {
  postId    String
  productId String
  sortOrder Int      @default(0)
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
}

model BlogPostGuide {
  postId    String
  guideId   String
  sortOrder Int         @default(0)
  post      BlogPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  guide     BuyingGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([postId, guideId])
}

model BlogPostCategory {
  postId     String
  categoryId String
  sortOrder  Int      @default(0)
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model Comparison {
  id              String              @id @default(cuid())
  title           String
  slug            String              @unique
  introduction    String
  comparisonTable Json?
  strengths       Json?
  weaknesses      Json?
  pricingNotes    String?
  bestFor         String?
  verdict         String?
  faqItems        Json?
  heroImage       String?
  heroImageAlt    String?
  status          Status              @default(DRAFT)
  publishedAt     DateTime?
  authorId        String?
  author          Author?             @relation(fields: [authorId], references: [id])
  products        ComparisonProduct[]
  stores          ComparisonStore[]
  seoTitle        String?
  seoDescription  String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  robotsIndex     Boolean             @default(true)
  robotsFollow    Boolean             @default(true)
  schemaEnabled   Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model ComparisonProduct {
  comparisonId String
  productId    String
  sortOrder    Int        @default(0)
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([comparisonId, productId])
}

model ComparisonStore {
  comparisonId String
  storeId      String
  sortOrder    Int        @default(0)
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([comparisonId, storeId])
}

model EditorialPage {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  intro          String?
  content        String
  status         Status    @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  robotsIndex    Boolean   @default(true)
  robotsFollow   Boolean   @default(true)
  schemaEnabled  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model NavigationItem {
  id        String           @id @default(cuid())
  label     String
  url       String
  sortOrder Int              @default(0)
  active    Boolean          @default(true)
  parentId  String?
  parent    NavigationItem?  @relation("NavigationTree", fields: [parentId], references: [id])
  children  NavigationItem[] @relation("NavigationTree")
}

model FooterSection {
  id        String  @id @default(cuid())
  title     String
  content   String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  links     Json?
}

model AffiliateLink {
  id         String   @id @default(cuid())
  label      String
  url        String
  clickCount Int      @default(0)
  active     Boolean  @default(true)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())
}

model AffiliateClick {
  id          String   @id @default(cuid())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String?
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeName   String?
  placement   String
  pagePath    String
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
  @@index([placement, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([readAt])
}

model SeoMetadata {
  id             String  @id @default(cuid())
  entityType     String
  entityId       String?
  title          String?
  description    String?
  canonicalUrl   String?
  openGraphImage String?
  noIndex        Boolean @default(false)
  jsonLd         Json?
  dealId         String? @unique
  deal           Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
}

model SiteSettings {
  id                     String   @id @default("global")
  websiteName            String
  logo                   String?
  favicon                String?
  primaryColor           String   @default("#101a2f")
  accentColor            String   @default("#f36b2b")
  supportEmail           String?
  socialMedia            Json?
  announcementItems      Json?
  defaultSeoTitle        String?
  defaultSeoDescription  String?
  siteUrl                String?
  homepageSeoTitle       String?
  homepageSeoDescription String?
  homepageCanonicalUrl   String?
  homepageOgTitle        String?
  homepageOgDescription  String?
  homepageOgImage        String?
  homepageRobotsIndex    Boolean  @default(true)
  homepageRobotsFollow   Boolean  @default(true)
  homepageSchemaEnabled  Boolean  @default(true)
  googleSiteVerification String?
  bingSiteVerification   String?
  affiliateDisclosure    String?
  copyright              String?
  searchPlaceholder      String?
  headerCtaLabel         String?
  headerCtaUrl           String?
  footerDescription      String?
  newsletterTitle        String?
  newsletterText         String?
  analyticsIds           Json?
  updatedAt              DateTime @updatedAt
}
